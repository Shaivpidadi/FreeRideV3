{
  "name": "freeride-telemetry",
  "version": "0.3.0",
  "private": true,
  "description": "FreeRide site + telemetry beacon receiver running on Cloudflare Workers, backed by D1 and KV.",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "schema:remote": "wrangler d1 execute freeride-telemetry --remote --file=./schema.d1.sql",
    "rollups:rebuild": "wrangler d1 execute freeride-telemetry --remote --file=./rebuild_rollups.sql"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
